<UserControl x:Class="DirectorPrompt.Views.Components.DialogEntryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:DirectorPrompt.ViewModels"
             xmlns:loc="clr-namespace:DirectorPrompt.Localization"
             xmlns:components="clr-namespace:DirectorPrompt.Views.Components"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DialogEntryViewModel}">
    <UserControl.Styles>
        <Style Selector="TextBlock.tool-error">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style Selector="Border.message">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="MaxWidth" Value="880" />
        </Style>
        <Style Selector="Border.message.director">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="MaxWidth" Value="720" />
        </Style>
        <Style Selector="Border.message.error">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="StackPanel.message-actions Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.message-menu">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Border Classes="message"
            Classes.director="{Binding IsDirector}"
            Classes.error="{Binding HasError}"
            Margin="0,12">
        <StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto">

                <TextBlock Grid.Column="0"
                           Text="{Binding Role}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsNarrative}">
                    <StackPanel Classes="message-actions"
                                Orientation="Horizontal"
                                Spacing="6"
                                IsVisible="{Binding IsMenuOpen}">
                        <Button x:Name="CopyEntryButton"
                                Tag="{Binding}"
                                Click="OnCopyEntry"
                                ToolTip.Tip="{Binding [Common.Copy], Source={x:Static loc:Loc.Instance}}">
                            <fa:FASymbolIcon Symbol="Copy" />
                        </Button>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="6"
                                    IsVisible="{Binding IsLast}">
                            <Button Tag="{Binding}"
                                    Click="OnEditEntry"
                                    ToolTip.Tip="{Binding [Dialog.Edit], Source={x:Static loc:Loc.Instance}}">
                                <fa:FASymbolIcon Symbol="Edit" />
                            </Button>
                            <Button Tag="{Binding}"
                                    Click="OnRollbackRound"
                                    ToolTip.Tip="{Binding [Dialog.Rollback], Source={x:Static loc:Loc.Instance}}">
                                <fa:FASymbolIcon Symbol="Undo" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="MessageMenuButton"
                            Classes="message-menu"
                            Classes.open="{Binding IsMenuOpen}"
                            Click="OnMoreButtonClick"
                            Tag="{Binding}"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsNotProcessing, FallbackValue=False}">
                        <fa:FASymbolIcon Symbol="MoreVertical" />
                    </Button>
                </StackPanel>
            </Grid>

            <Expander
                Header="{Binding [Dialog.CreationProcess], Source={x:Static loc:Loc.Instance}}"
                IsVisible="{Binding HasActivities}"
                IsExpanded="{Binding IsActivitiesExpanded, Mode=TwoWay}"
                Margin="0,4,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Activities}"
                                  IsVisible="{Binding IsActivitiesExpanded}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:NarrationActivityViewModel">
                                <Border Margin="0,3" Padding="8,4" CornerRadius="4"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <ProgressBar IsIndeterminate="True" Height="2"
                                                     IsVisible="{Binding IsRunning}" />
                                        <Expander Header="{Binding Header}" HorizontalContentAlignment="Stretch"
                                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                            <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Disabled"
                                                          IsVisible="{Binding IsExpanded}">
                                                <StackPanel Spacing="8">
                                                    <Border Padding="8" CornerRadius="4"
                                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                            IsVisible="{Binding HasArguments}">
                                                        <TextBlock Text="{Binding Arguments}" TextWrapping="Wrap"
                                                                   FontSize="12" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                               Classes.tool-error="{Binding HasError}"
                                                               FontSize="12" Margin="0,4" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Expander>

            <!-- 内容区域: 四种状态重叠, 同一时刻只显示一个 -->
            <Grid Margin="0,4,0,0">
                <!-- 错误状态: 显示错误信息 -->
                <StackPanel
                    IsVisible="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   VerticalAlignment="Top" />
                    </StackPanel>
                </StackPanel>
                <!-- 导演指令: 按指令分块渲染 Markdown -->
                <ItemsControl ItemsSource="{Binding DirectorBlocks}"
                              IsVisible="{Binding ShowDirectorContent}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding TypeDisplay}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,2" />
                                    <components:MarkdownViewer
                                        Markdown="{Binding Content}"
                                        MarkdownDocument="{Binding MarkdownDocument}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 叙事输出: 已渲染 Markdown 与尚未渲染的流式文本尾部同时显示 -->
                <StackPanel IsVisible="{Binding ShowNarrativeContent}">
                    <components:MarkdownViewer Markdown="{Binding Content}"
                                               IsStreaming="{Binding IsStreaming}"
                                               MarkdownDocument="{Binding MarkdownDocument}" />
                </StackPanel>

                <!-- 编辑模式: TextBox 替换正文 -->
                <StackPanel
                    IsVisible="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <TextBox
                        Text="{Binding EditingContent}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="100"
                        Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Tag="{Binding}"
                                Click="OnSaveEditClick"
                                Padding="12,6"
                                Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fa:FASymbolIcon Symbol="Save" />
                                <TextBlock
                                    Text="{Binding [Common.Save], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </Button>
                        <Button Tag="{Binding}"
                                Click="OnCancelEditClick"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fa:FASymbolIcon Symbol="Dismiss" />
                                <TextBlock
                                    Text="{Binding [Common.Cancel], Source={x:Static loc:Loc.Instance}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
