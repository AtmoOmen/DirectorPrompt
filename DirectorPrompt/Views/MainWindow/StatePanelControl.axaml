<UserControl x:Class="DirectorPrompt.Views.StatePanelControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="clr-namespace:DirectorPrompt.ViewModels"
             xmlns:loc="clr-namespace:DirectorPrompt.Localization"
             xmlns:components="clr-namespace:DirectorPrompt.Views.Components"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
        <StackPanel>
            <Expander IsExpanded="True" Margin="0,0,0,8">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fa:FASymbolIcon Symbol="Play" FontSize="14"
                                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="{Binding [State.Panel.Title], Source={x:Static loc:Loc.Instance}}"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <StackPanel>
                    <Grid Margin="0,2" ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding [State.Panel.Scene], Source={x:Static loc:Loc.Instance}}"
                                   Foreground="Gray" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding StatePanel.CurrentSceneLabel}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding StatePanel.StateItems}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               FontWeight="SemiBold"
                                               Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Expander>

            <Expander IsExpanded="True" Margin="0,0,0,8">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fa:FASymbolIcon Symbol="Message" FontSize="14"
                                         Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="{Binding [Directive.Panel.Title], Source={x:Static loc:Loc.Instance}}"
                            FontWeight="SemiBold" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding DirectivesPanel.Directives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2"
                                    Padding="8,4"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    CornerRadius="4">
                                <StackPanel>
                                    <StackPanel IsVisible="{Binding IsEditing, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap" />
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Text="{Binding TTLLabel}"
                                                       FontSize="11"
                                                       Foreground="Gray"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        DockPanel.Dock="Right">
                                                <Button Padding="6,4"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Margin="4,0,0,0"
                                                        Click="OnEditDirective"
                                                        Tag="{Binding}"
                                                        ToolTip.Tip="{Binding [Common.Edit], Source={x:Static loc:Loc.Instance}}">
                                                    <fa:FASymbolIcon Symbol="Edit" FontSize="12" />
                                                </Button>
                                                <components:RemoveButton Padding="6,4"
                                                                         Margin="4,0,0,0"
                                                                         Click="OnDeleteDirective"
                                                                         Tag="{Binding}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel IsVisible="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox Text="{Binding EditingContent}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="72" />
                                        <Grid Margin="0,6,0,0" ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding [Directive.TTL], Source={x:Static loc:Loc.Instance}}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <fa:FANumberBox Width="92"
                                                                Value="{Binding EditingTTL, Converter={StaticResource NumberBoxValue}}"
                                                                Minimum="1"
                                                                SmallChange="1"
                                                                LargeChange="5"
                                                                IsEnabled="{Binding EditingIsPermanent, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                <CheckBox Content="{Binding [Directive.Permanent], Source={x:Static loc:Loc.Instance}}"
                                                          IsChecked="{Binding EditingIsPermanent}"
                                                          VerticalAlignment="Center"
                                                          Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,6,0,0">
                                            <Button Content="{Binding [Common.Save], Source={x:Static loc:Loc.Instance}}"
                                                    Padding="12,6"
                                                    Margin="0,0,4,0"
                                                    Click="OnSaveDirectiveEditClick"
                                                    Tag="{Binding}" />
                                            <Button Content="{Binding [Common.Cancel], Source={x:Static loc:Loc.Instance}}"
                                                    Padding="12,6"
                                                    Click="OnCancelDirectiveEditClick"
                                                    Tag="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
