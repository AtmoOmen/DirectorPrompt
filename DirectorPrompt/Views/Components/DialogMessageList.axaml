<UserControl x:Class="DirectorPrompt.Views.Components.DialogMessageList"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:DirectorPrompt.Views.Components"
             Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="DialogEntryTemplate">
            <components:DialogEntryView />
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,Auto,Auto">
        <ListBox x:Name="DialogEntriesListBox"
                 ItemsSource="{Binding Entries, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 ItemTemplate="{StaticResource DialogEntryTemplate}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="16,8,8,8"
                 Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 ScrollViewer.BringIntoViewOnFocusChange="False">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel CacheLength="1" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
        <ContentPresenter Grid.Column="1"
                          Content="{Binding RailContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <ScrollBar x:Name="MessageScrollBar"
                   Grid.Column="2"
                   Orientation="Vertical"
                   Visibility="Auto"
                   Scroll="OnScrollBarScroll" />
    </Grid>
</UserControl>
