<UserControl x:Class="DirectorPrompt.Views.Components.DirectiveInputControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DirectorPrompt.ViewModels"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:loc="clr-namespace:DirectorPrompt.Localization"
             xmlns:components="clr-namespace:DirectorPrompt.Views.Components"
             mc:Ignorable="d">
    <StackPanel x:Name="RootPanel" d:DataContext="{d:DesignInstance Type=vm:DirectiveInputViewModel}">
        <ItemsControl ItemsSource="{Binding Directives}"
                      Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:DirectiveItemViewModel">
                    <Border Margin="0,2"
                            Padding="10,6"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <!-- 有 TTL 指令: 两行布局, 第一行类型+TTL+按钮, 第二行内容 -->
                            <StackPanel IsVisible="{Binding HasTTL, Converter={StaticResource BoolToVisibility}}">
                                <Grid Margin="0,0,0,4" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TypeDisplay}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <fa:FANumberBox Grid.Column="1"
                                                    Width="180"
                                                    Value="{Binding TTL, Converter={StaticResource NumberBoxValue}}"
                                                    Minimum="1"
                                                    SmallChange="1"
                                                    LargeChange="5"
                                                    Margin="0,0,4,0"
                                                    IsEnabled="{Binding IsPermanent, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                                    VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding [Directive.Input.TTLUnit], Source={x:Static loc:Loc.Instance}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="3"
                                              Content="{Binding [Directive.Permanent], Source={x:Static loc:Loc.Instance}}"
                                              IsChecked="{Binding IsPermanent}"
                                              VerticalAlignment="Center"
                                              Margin="8,0,0,0" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                                        <Button Padding="12,8"
                                                MinWidth="36"
                                                Margin="2,0"
                                                Command="{Binding $parent[ItemsControl].((vm:DirectiveInputViewModel)DataContext).MoveUpCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="↑" FontSize="14" />
                                        </Button>
                                        <Button Padding="12,8"
                                                MinWidth="36"
                                                Margin="2,0"
                                                Command="{Binding $parent[ItemsControl].((vm:DirectiveInputViewModel)DataContext).MoveDownCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="↓" FontSize="14" />
                                        </Button>
                                        <Button Padding="12,8"
                                                MinWidth="36"
                                                Margin="2,0"
                                                Command="{Binding $parent[ItemsControl].((vm:DirectiveInputViewModel)DataContext).RemoveDirectiveCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="✕" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBox Text="{Binding Content}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinLines="1"
                                         MaxLines="3"
                                         BorderThickness="0"
                                         Background="Transparent" />
                            </StackPanel>
                            <!-- 无 TTL 指令: 单行布局 -->
                            <Grid
                                IsVisible="{Binding HasTTL, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                                ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TypeDisplay}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Content}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinLines="1"
                                         MaxLines="3"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Padding="12,8"
                                            MinWidth="36"
                                            Margin="2,0"
                                            Command="{Binding $parent[ItemsControl].((vm:DirectiveInputViewModel)DataContext).MoveUpCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="↑" FontSize="14" />
                                    </Button>
                                    <Button Padding="12,8"
                                            MinWidth="36"
                                            Margin="2,0"
                                            Command="{Binding $parent[ItemsControl].((vm:DirectiveInputViewModel)DataContext).MoveDownCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="↓" FontSize="14" />
                                    </Button>
                                    <Button Padding="12,8"
                                            MinWidth="36"
                                            Margin="2,0"
                                            Command="{Binding $parent[ItemsControl].((vm:DirectiveInputViewModel)DataContext).RemoveDirectiveCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="✕" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Margin="0,4,0,0">
            <Grid Margin="0,0,0,4" ColumnDefinitions="Auto,Auto,*">
                <components:PathComboBox Grid.Column="0"
                                         Width="200"
                                         SelectedIndex="0"
                                         SelectionChanged="OnDirectiveTypeChanged"
                                         Margin="0,0,4,0">
                    <ComboBoxItem Content="{Binding [Directive.Type.Plot], Source={x:Static loc:Loc.Instance}}" />
                    <ComboBoxItem Content="{Binding [Directive.Type.Constraint], Source={x:Static loc:Loc.Instance}}" />
                    <ComboBoxItem Content="{Binding [Directive.Type.SceneChange], Source={x:Static loc:Loc.Instance}}" />
                </components:PathComboBox>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            IsVisible="{Binding InputHasTTL, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="1"
                            Margin="8,2"
                            Background="{DynamicResource ControlElevationBorderBrush}" />
                    <TextBlock Text="{Binding [Directive.TTL], Source={x:Static loc:Loc.Instance}}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <fa:FANumberBox Width="150"
                                    Value="{Binding InputTTL, Converter={StaticResource NumberBoxValue}}"
                                    Minimum="1"
                                    SmallChange="1"
                                    LargeChange="5"
                                    IsEnabled="{Binding InputIsPermanent, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <CheckBox Content="{Binding [Directive.Permanent], Source={x:Static loc:Loc.Instance}}"
                              IsChecked="{Binding InputIsPermanent}"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <TextBox Margin="0,0,0,4"
                     Text="{Binding InputContent}"
                     TextWrapping="Wrap"
                     MaxHeight="300"
                     AcceptsReturn="True" />

            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  Margin="0,4,0,0">
                <ContentPresenter Grid.Column="0"
                                  Margin="0,0,8,0"
                                  MaxWidth="240"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Content="{Binding FooterContent, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <Button Grid.Column="1"
                        Width="150"
                        Margin="0,0,4,0"
                        Padding="12,6"
                        Command="{Binding AddDirectiveCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fa:FASymbolIcon Symbol="Add" />
                        <TextBlock Text="{Binding [Common.Add], Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="2"
                        Width="1"
                        Margin="4,4"
                        Background="{DynamicResource ControlElevationBorderBrush}"
                        IsVisible="{Binding ShowSendButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                <Button Grid.Column="3"
                        Width="150"
                        Margin="4,0,0,0"
                        Padding="16,6"
                        IsVisible="{Binding ShowSendButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding SendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding IsProcessing, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fa:FASymbolIcon Symbol="Send" />
                        <TextBlock Text="{Binding [Dialog.SendDirective], Source={x:Static loc:Loc.Instance}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
